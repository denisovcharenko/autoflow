{
  "name": "autoflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "post": "node --env-file-if-exists=.env src/run.js",
    "post:dry": "node --env-file-if-exists=.env src/run.js --dry-run",
    "check": "node --env-file-if-exists=.env src/check.js",
    "refresh-tokens": "node --env-file-if-exists=.env src/refresh-tokens.js",
    "test": "node --test"
  },
  "dependencies": {
    "google-auth-library": "^11.3.3"
  }
}
